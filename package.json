{
  "name": "dsh-codex-effort-slider",
  "version": "1.0.0",
  "private": true,
  "description": "A Codex-style reasoning-effort slider for DeepSeek Harness",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "slider",
    "ui"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "install-profile.ps1",
    "install.cmd",
    "LICENSE",
    "test",
    "preview",
    "README.md",
    "locale"
  ],
  "scripts": {
    "test": "node test/client.test.mjs",
    "preview": "node preview/make-preview.mjs",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pack-dist.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
