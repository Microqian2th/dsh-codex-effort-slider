{
  "name": "dsh-codex-effort-slider",
  "version": "1.2.0",
  "description": "DeepSeek 鲸鱼配色的推理等级细轨滑条：把 DSH 模型菜单里的「推理等级」一行换成可拖动的 16px 细轨 + 22px 浮球，高档亮起深海极光与星尘 / A DeepSeek-blue thin-rail reasoning-effort slider for DeepSeek Harness",
  "license": "MIT",
  "author": "Microqian2th",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microqian2th/dsh-codex-effort-slider.git"
  },
  "bugs": {
    "url": "https://github.com/Microqian2th/dsh-codex-effort-slider/issues"
  },
  "homepage": "https://github.com/Microqian2th/dsh-codex-effort-slider#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "slider",
    "ui"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "install-profile.ps1",
    "install.cmd",
    "LICENSE",
    "test",
    "preview",
    "README.md"
  ],
  "scripts": {
    "test": "node test/client.test.mjs",
    "preview": "node preview/make-preview.mjs",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pack-dist.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
