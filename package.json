{
  "name": "dsh-codex-effort-slider",
  "version": "1.1.4",
  "description": "Codex-style reasoning-effort slider with local previews and optimized animations for the DSH model menu",
  "license": "MIT",
  "author": "Microqian2th",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yutai233/dsh-codex-effort-slider.git"
  },
  "bugs": {
    "url": "https://github.com/Yutai233/dsh-codex-effort-slider/issues"
  },
  "homepage": "https://github.com/Yutai233/dsh-codex-effort-slider#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "slider",
    "ui"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "install-profile.ps1",
    "install.cmd",
    "LICENSE",
    "test",
    "preview",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:functional": "node test/client.test.mjs",
    "test:performance": "node test/performance.test.mjs",
    "test:lifecycle": "node test/lifecycle.test.mjs",
    "preview": "node preview/make-preview.mjs",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pack-dist.ps1",
    "pack:npm": "npm pack"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
